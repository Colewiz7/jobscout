{
  "name": "JobSeer",
  "short_name": "JobSeer",
  "description": "A calm desk for job triage and applications",
  "start_url": "/inbox",
  "scope": "/",
  "display": "standalone",
  "background_color": "#151412",
  "theme_color": "#151412",
  "icons": [
    {"src": "/static/icons/jobseer-fan-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "/static/icons/jobseer-fan-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "share_target": {
    "action": "/inbox",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {"title": "title", "text": "text", "url": "share_url"}
  }
}
